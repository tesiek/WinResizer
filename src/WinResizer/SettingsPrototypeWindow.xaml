<ui:FluentWindow x:Class="WinResizer.SettingsPrototypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:WinResizer.Views"
        Title="WinResizer"
        ExtendsContentIntoTitleBar="True"
        Width="1000"
        Height="640"
        MinWidth="980"
        MinHeight="480"
        UseLayoutRounding="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource WindowForeground}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewMouseDown="Window_PreviewMouseDown"
        SourceInitialized="Window_SourceInitialized">
  <Grid x:Name="RootLayout"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Focusable="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="MainTitleBar" Grid.Row="0" Title="WinResizer">
      <ui:TitleBar.Icon>
        <ui:ImageIcon x:Name="MainTitleBarIcon" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>
    <Grid Grid.Row="1" MaxWidth="1360" HorizontalAlignment="Stretch">
      <TabControl x:Name="SettingsTabs"
                  SelectionChanged="SettingsTabs_SelectionChanged"
                  Style="{StaticResource PrototypeTabControlStyle}">
        <TabItem Header="Hotkeys" Style="{StaticResource PrototypeTabItemStyle}"><views:HotkeysView x:Name="HotkeysPage" /></TabItem>
        <TabItem Header="Presets" Style="{StaticResource PrototypeTabItemStyle}"><views:PresetsView x:Name="PresetsPage" /></TabItem>
        <TabItem Header="Processes" Style="{StaticResource PrototypeTabItemStyle}"><views:ProcessesView x:Name="ProcessesPage" /></TabItem>
        <TabItem Header="Ignored" Style="{StaticResource PrototypeTabItemStyle}"><views:IgnoredWindowsView x:Name="IgnoredWindowsPage" /></TabItem>
        <TabItem Header="Profiles" Style="{StaticResource PrototypeTabItemStyle}"><views:ProfilesView x:Name="ProfilesPage" /></TabItem>
        <TabItem Header="Settings" Style="{StaticResource PrototypeTabItemStyle}"><views:SettingsView x:Name="SettingsPage" /></TabItem>
        <TabItem Header="About" Style="{StaticResource PrototypeTabItemStyle}"><views:AboutView /></TabItem>
      </TabControl>
    </Grid>
    <Border Grid.Row="2" MaxWidth="1360" HorizontalAlignment="Stretch" Style="{StaticResource StatusBarStyle}">
      <TextBlock x:Name="DpiStatusText" Text="DPI: detecting…" />
    </Border>
  </Grid>
</ui:FluentWindow>
