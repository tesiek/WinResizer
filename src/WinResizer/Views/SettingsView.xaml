<UserControl x:Class="WinResizer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid Style="{StaticResource PageRootGridStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0"
          HorizontalAlignment="Left"
          DataContext="{Binding ThemePreferences}">
      <ComboBox x:Name="ThemeComboBox"
                Width="130"
                HorizontalAlignment="Left"
                Style="{StaticResource GridComboBoxLayoutStyle}"
                Margin="0"
                Padding="16,1,6,1"
                ItemsSource="{Binding ThemeOptions}"
                SelectedItem="{Binding SelectedTheme, Mode=OneWay}"
                SelectionChanged="Theme_SelectionChanged" />
    </Grid>

    <CheckBox x:Name="StartupCheckBox"
              Grid.Row="1"
              Content="Run on system startup"
              HorizontalAlignment="Left"
              Margin="0,18,0,0"
              IsChecked="{Binding IsEnabled, Mode=OneWay}"
              IsEnabled="{Binding IsAvailable}"
              ToolTip="{Binding ErrorMessage}"
              Click="Startup_Click" />

    <CheckBox x:Name="DwmFrameCompensationCheckBox"
              Grid.Row="2"
              HorizontalAlignment="Left"
              Margin="0,8,0,0"
              Content="Compensate for Desktop Window Manager frame effects"
              DataContext="{Binding DwmFrameCompensation}"
              IsChecked="{Binding CompensateDwmFrameEffects, Mode=OneWay}"
              Click="DwmFrameCompensation_Click" />

    <TextBlock Grid.Row="3"
               Margin="0,22,0,0"
               HorizontalAlignment="Left"
               Text="WinResizer configuration settings are currently stored in the following file:"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
               FontWeight="Normal" />

    <TextBlock Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap">
      <Hyperlink Click="ConfigPath_Click"
                 Cursor="Hand"
                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                 TextDecorations="{x:Null}">
        <Run Text="{Binding ConfigPath, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=OneWay}" />
      </Hyperlink>
    </TextBlock>

    <StackPanel Grid.Row="5"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                Margin="0,14,0,0">
      <ui:Button Content="Import"
                 Style="{StaticResource ToolbarButtonLayoutStyle}"
                 Margin="0,0,12,0"
                 Click="Import_Click" />
      <ui:Button Content="Export"
                 Style="{StaticResource ToolbarButtonLayoutStyle}"
                 Margin="0"
                 Click="Export_Click" />
    </StackPanel>
  </Grid>
</UserControl>
