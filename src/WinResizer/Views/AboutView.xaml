<UserControl x:Class="WinResizer.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid Style="{StaticResource PageRootGridStyle}">
    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image x:Name="AboutIcon"
               Width="32"
               Height="32"
               Stretch="Uniform"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock x:Name="AboutTitle"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock x:Name="AboutDescription"
                 Margin="0,24,0,0"
                 FontSize="14"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Text="Lightweight Windows utility for saving and restoring&#10;window positions and sizes." />
      <TextBlock x:Name="AboutAttribution"
                 Margin="0,18,0,0"
                 FontSize="13"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="Based on WindowResizer by caoyue&#10;Enhanced with a redesigned UI and additional features." />
      <TextBlock x:Name="AboutPlatform"
                 Margin="0,18,0,0"
                 FontSize="13"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="Windows 10 / 11 · x64 · Portable&#10;.NET Framework 4.8 · WPF-UI 4.3.0&#10;MIT License" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,24,0,0">
        <ui:Button Content="GitHub"
                   Style="{StaticResource ToolbarButtonLayoutStyle}"
                   Click="GitHub_Click" />
        <ui:Button Content="Original project"
                   Style="{StaticResource ToolbarButtonLayoutStyle}"
                   Margin="4,0,0,0"
                   Click="OriginalProject_Click" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
