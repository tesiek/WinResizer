<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>WinResizer</AssemblyName>
    <RootNamespace>WinResizer</RootNamespace>
    <AssemblyTitle>WinResizer</AssemblyTitle>
    <Product>WinResizer</Product>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\AppIcon-light.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(PlatformTarget)' == 'x64'">
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\x64\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinResizer.Runtime\WinResizer.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\AppIcon-light.ico">
      <LogicalName>WinResizer.Resources.AppIcon-light.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\AppIcon-dark.ico">
      <LogicalName>WinResizer.Resources.AppIcon-dark.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources\Osd\*.png" />
    <Resource Include="Resources\Osd\*.png" />
  </ItemGroup>
  <Target Name="PruneReleasePdbOutput"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_WpfReleasePdbs Include="$(TargetDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_WpfReleasePdbs)" />
  </Target>
</Project>
